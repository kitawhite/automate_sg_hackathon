# AeroCast AI - environment template.
# Copy this file to ".env" (same folder) and fill in the value, then run the app.
#   cp .env.example .env
# The real .env is gitignored - never commit your key.
#
# OPTIONAL. Only needed for the live Claude-written controller brief in the
# dashboard. Without it, the dashboard uses a built-in template and runs fine.
# Get a key at https://console.anthropic.com (billing required; uses the cheap
# claude-haiku-5-5 model).
ANTHROPIC_API_KEY=
